class Solution {
    public boolean isPalindrome(int n) {
        // code here
        n=Math.abs(n);//Converting into positive number in order to handle the negative number 
        int org=n;
        int rev=0;
        while(n>0){
        int ld=n%10;
        rev=rev*10+ld;
        n=n/10;
        }
        return rev==org;
        
    }
}
