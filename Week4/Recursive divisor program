class Divisors {

    static void printDivisors(int n, int i) {
        if (i > n) {
            return;
        }

        if (n % i == 0) {
            System.out.print(i + " ");
        }

        printDivisors(n, i + 1);
    }
  public static void main(String[] args) {
        int n = 12;

        printDivisors(n, 1);
    }
}
