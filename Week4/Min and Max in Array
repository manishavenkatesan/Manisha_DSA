class Solution {
    public ArrayList<Integer> getMinMax(int[] arr) {
        // code Here
        int large=arr[0];
        int small=arr[0];
        for(int i=0;i<arr.length;i++){
            if(large<arr[i]){
                large=arr[i];
            }
            if(small>arr[i]){
                small=arr[i];
            }
        }
       ArrayList<Integer> result = new ArrayList<>();
               result.add(small);
               result.add(large);
               return result;
    }
}
