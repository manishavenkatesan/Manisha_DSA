class Solution {

    public long minMaxProduct(int[] arr1, int[] arr2) {
        // code here
        int max1=arr1[0];
        int max2=arr2[0];
        for(int i=0;i<arr1.length;i++){
            if(max1<arr1[i]){
                max1=arr1[i];
            }
            
        }
        for (int j=0;j<arr2.length;j++){
            if(max2<arr2[j]){
                max2=arr2[j];
        }
    }
    return max1[i]*max2[j];
}
}
